# Copy to .env for local development (gitignored — never commit real values).

# Postgres connection string. Locally: your own Postgres, or a free hosted
# instance (Neon, Railway, Supabase, ...). In production, your host usually
# injects this for you.
DATABASE_URL=postgres://user:password@localhost:5432/internez

# Most hosted Postgres requires TLS; local Postgres and CI service
# containers usually don't have it configured at all. Set to "disable" for
# those; omit (or set anything else) to keep it on.
# DATABASE_SSL=disable

# Signs session cookies. Falls back to a fixed dev value if unset — set a
# real random secret before deploying anywhere real.
# SESSION_SECRET=

# Comma-separated list of origins allowed to make credentialed requests.
# Defaults to the local Vite dev server if unset.
# CORS_ORIGIN=https://internez.eu,https://www.internez.eu

# Makes the session cookie's `secure` flag require HTTPS. Most hosts
# (Railway included) set this automatically — only set it by hand if yours
# doesn't.
# NODE_ENV=production

# PORT=4000

# When set, every API route except /health and /early-access requires this
# key before the session is usable (see middleware/earlyAccess.ts) — for
# gating the whole app behind a shared key during private early access.
# Unset (the default) disables the gate entirely.
# EARLY_ACCESS_KEY=
