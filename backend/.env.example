# Copy to .env for local development (gitignored — never commit real values);
# `npm run dev:env` starts the backend with it loaded.

# Postgres connection string. Locally: your own Postgres, or a free hosted
# instance (Neon, Railway, Supabase, ...). In production, your host usually
# injects this for you.
DATABASE_URL=postgres://user:password@localhost:5432/internez

# Most hosted Postgres requires TLS; local Postgres and CI service
# containers usually don't have it configured at all. Set to "disable" for
# those; omit (or set anything else) to keep it on.
# DATABASE_SSL=disable

# Signs session cookies. Falls back to a fixed dev value if unset — set a
# real random secret before deploying anywhere real.
# SESSION_SECRET=

# Comma-separated list of origins allowed to make credentialed requests.
# Defaults to the local Vite dev server if unset.
# CORS_ORIGIN=https://internez.eu,https://www.internez.eu

# Makes the session cookie's `secure` flag require HTTPS. Most hosts
# (Railway included) set this automatically — only set it by hand if yours
# doesn't.
# NODE_ENV=production

# PORT=4000

# When set, every API route except /health and /early-access requires this
# key (see middleware/earlyAccess.ts) — for gating the whole app behind a
# shared key during private early access. Unset (the default) disables
# the gate entirely.
# EARLY_ACCESS_KEY=

# Resend API key for transactional email (currently just password reset —
# see services/email.ts). Unset in local dev/CI simply logs the email to
# the console instead of sending it, so this never blocks running the app
# without real email credentials.
# RESEND_API_KEY=

# The "from" address on outgoing email. Needs a domain verified in Resend
# before it can send to arbitrary recipients — until internez.eu is
# verified there, Resend's own onboarding@resend.dev works but only
# delivers to the Resend account's own email address.
# EMAIL_FROM=InternEZ <noreply@internez.eu>

# Base URL of the deployed frontend, used to build links inside emails
# (e.g. the password reset link). Defaults to the local Vite dev server.
# APP_URL=https://internez.eu

# Shared secret for POST /api/admin/sync-listings (see routes/admin.ts),
# which triggers the listing ingestion pipeline. Send it as the
# X-Sync-Key header. Unset means the route can never succeed (no key it's
# willing to accept), not that it's open.
# SYNC_SECRET=

# RapidAPI key for the Active Jobs DB feed (services/ingestion/). The
# plan's monthly job quota is split per country in
# src/data/sourcedCountries.ts — keep those caps in line with the plan.
# ACTIVE_JOBS_DB_API_KEY=
