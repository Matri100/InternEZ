node_modules/
dist/
.DS_Store
*.log

# Local SQLite dev database (data, not code) — WAL/SHM are the write-ahead
# log and shared-memory files better-sqlite3 creates alongside the main file.
backend/data/*.sqlite
backend/data/*.sqlite-wal
backend/data/*.sqlite-shm

# Secrets — none exist yet, but this repo will hold real ones once it's
# deployed, so the pattern is in place before that day arrives.
.env
.env.*
!.env.example
