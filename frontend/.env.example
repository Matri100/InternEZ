# Copy to .env.local for local development (gitignored — never commit real
# values). Not needed at all for local dev — Vite's dev server proxies
# "/api" straight to localhost:4000 (see vite.config.ts).

# Only needed for a real deployment, where the frontend is a static build
# served from its own origin with no dev-server proxy. Baked in at build
# time, so this is a build-step env var (e.g. a Cloudflare Pages build
# variable), not something read at runtime in the browser.
# VITE_API_BASE_URL=https://api.internez.eu/api
